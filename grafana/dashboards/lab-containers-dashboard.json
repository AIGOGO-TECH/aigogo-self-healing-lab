      },
      "title": "Every service in the demo, on one laptop",
      "type": "text"
    },
    {
      "datasource": {
        "type": "elasticsearch",
        "uid": "es-docker-stats"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8
          },
          "unit": "decmbytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "bucketAggs": [
            {
              "field": "container.keyword",
              "id": "3",
              "settings": {
                "min_doc_count": "1",
