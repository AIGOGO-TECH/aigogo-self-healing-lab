# containerlab writes per-node runtime state here on every deploy
clab/clab-*/
# n8n / Elasticsearch / NetBox data live in docker volumes, not the repo
*.sqlite
*.sqlite-*

# secrets — generated by scripts/gen-secrets.sh
.env

# python bytecode — never ship it, and the Salt fileserver would serve it
__pycache__/
*.py[cod]

# local backup archives — these hold real data, never commit them
backups/

# The provisioning override window. Created by bootstrap for the seconds
# it is converging, removed afterwards and by its EXIT trap. Never commit
# one: it authorises every override to anything that can reach salt-api.
salt/states/provisioning.window

# Rendered by clab/gen-configs.py at bootstrap, from .env. They carry the
# IS-IS key and the management prefix, so committing them puts a credential
# back in the repository and pins the subnet for everyone who clones it.
clab/configs/*.cfg
clab/configs/srl4-*
netbox/plan.json
salt/pillar/fabric.sls
