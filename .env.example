# Copy to .env and fill in, or run: ./scripts/gen-secrets.sh
#
# .env is gitignored. Nothing in this stack reads a password from a source
# file any more -- compose, the Salt master config, the Salt proxy configs,
# the NetBox scripts and the n8n workflows all take theirs from here.

# ---- where the published ports listen -------------------------------------
# 127.0.0.1 by default: nothing in this stack is safe to expose to a LAN
# without a TLS-terminating reverse proxy in front of it. Set to 0.0.0.0
# only once that proxy exists.
BIND_ADDR=127.0.0.1

# ---- where the services are --------------------------------------------
# Every component reads its endpoints from here, so pointing this lab at an
# ISP's existing Elasticsearch, NetBox or Grafana is a change to this file
# and nothing else. The defaults are the bundled containers.
#
# To use your own instead of the bundled ones, set the URL here and drop the
# service from COMPOSE_PROFILES below.
ES_URL=http://elasticsearch:9200
KIBANA_URL=http://kibana:5601
NETBOX_URL=http://netbox:8080
SALT_API_URL=http://salt-master:8000
N8N_WEBHOOK_URL=http://n8n:5678/webhook/fault
# The management /24. Declared HERE, above the two lines that expand it:
# gen-secrets.sh copies this file to .env substituting only the password
# lines, so the order in this file is the order a shell sees. Every script
# runs `set -u` and sources .env, so a reference above its definition makes
# `. ./.env` fail with `MGMT_PREFIX: unbound variable` -- on a fresh clone,
# at the first step of bootstrap, with nothing to say what is wrong.
#
# This is the first thing to change if the lab will not start: Docker hands
# out 172.17+ and anything else already running on the host takes the next
# free /16. Pick a /24 nothing else is using; the nodes are .21 to .24.
MGMT_PREFIX=172.30.30

# Where the routers send syslog. Two destinations, both fixed: a syslog
# destination that moves stops working on the next restart. .30 is the
# collector that files every message, .31 is napalm-logs.
SYSLOG_ADDR=${MGMT_PREFIX}.30
NAPALM_LOGS_ADDR=${MGMT_PREFIX}.31

# Which bundled services to run. Remove one to run against your own:
#   COMPOSE_PROFILES=core            # bring your own ES, Kibana, NetBox, Grafana
#   COMPOSE_PROFILES=core,netbox     # bring your own observability stack only
COMPOSE_PROFILES=core,elastic,netbox,grafana

# ---- Elasticsearch ---------------------------------------------------------
# elastic is the bootstrap superuser, used only by es-init to create the
# four least-privilege users below. Nothing else authenticates as elastic.
ELASTIC_PASSWORD=

# kibana_system is a built-in user; its password is set by es-init.
KIBANA_SYSTEM_PASSWORD=

# Kibana refuses to start without a 32+ character key, and invents a random
# one per boot if it is unset -- which silently invalidates every saved
# object, including the data views.
KIBANA_ENCRYPTION_KEY=

# One user per component, each with only the index privileges it needs.
# If the Salt master is compromised it can write events; it cannot read
# the remediation history or touch Kibana's own indices.
SALT_ES_PASSWORD=
GRAFANA_ES_PASSWORD=
N8N_ES_PASSWORD=
STATS_ES_PASSWORD=
LOGS_ES_PASSWORD=
WATCHDOG_ES_PASSWORD=
PUSH_DETECT_ES_PASSWORD=

# ---- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ---- n8n -------------------------------------------------------------------
# n8n encrypts stored credentials with this key. If it changes, every
# credential already saved becomes unreadable -- back it up with the volume.
N8N_ENCRYPTION_KEY=

# n8n 1.x dropped N8N_BASIC_AUTH_* in favour of user management: the first
# browser visit creates an owner account. There is no way to seed that from
# the environment, so the port stays bound to ${BIND_ADDR} and the owner
# account is created by hand on first run.

# Pre-computed "Basic base64(n8n_agent:N8N_ES_PASSWORD)". The workflows read
# it as $env.ES_AUTH_HEADER, so no credential is stored inside an exported
# workflow JSON.
N8N_ES_AUTH_HEADER=

# ---- NetBox ----------------------------------------------------------------
# Changing this on an existing install does NOT change the database.
# Postgres reads POSTGRES_PASSWORD only when it initialises an empty data
# directory; afterwards the value here is only what NetBox *presents*. Rotate
# it on the database itself, then here:
#   docker exec netbox-postgres psql -U netbox -d netbox \
#     -c "ALTER USER netbox WITH PASSWORD '<new>';"
NETBOX_DB_PASSWORD=
NETBOX_SECRET_KEY=
NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_PASSWORD=
NETBOX_API_TOKEN=

# ---- salt-api --------------------------------------------------------------
# The shared secret n8n presents to salt-api. Scoped by salt/master.d/api.conf
# to exactly one function (state.apply) on exactly one target pattern (srl*).
SALT_API_SECRET=

# ---- devices ---------------------------------------------------------------
# Credentials the Salt proxy-minions use over JSON-RPC. In a real network
# these belong in a vault and are rotated; here they are at least no longer
# committed to git.
SRL_USERNAME=admin
SRL_PASSWORD=

# ---- the fabric ------------------------------------------------------------
# The IS-IS authentication key. Deliberately weak -- this is a lab -- but it
# is a credential, and a credential in source is a credential in everyone's
# clone. gen-secrets.sh writes a random one; clab/gen-configs.py reads it.
ISIS_AUTH_KEY=

# ---- containerlab ----------------------------------------------------------
# Everything about the topology that depends on the machine it runs on.
#
# Pinned on purpose -- :latest turned a working stack into a broken one
# twice. 24.10.1 is the last known-good arm64 SR Linux build; on amd64 a
# newer tag is usually fine.
SRL_IMAGE=ghcr.io/nokia/srlinux:24.10.1
FRR_IMAGE=quay.io/frrouting/frr:10.2.1
CLAB_IMAGE=ghcr.io/srl-labs/clab:0.79.0

# Per-node memory. The three SR Linux nodes are the whole budget on a
# laptop; drop these first if the host starts swapping.
SRL_MEMORY=2560MB
SRL_BORDER_MEMORY=2816MB

# ---- local LLM -------------------------------------------------------------
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# The per-device change ceiling, in BOTH places that enforce one: Salt's
# gate (salt/pillar/maintenance.sls, which must be edited to match) and
# the n8n circuit breaker, which reads this. Two independent limits is
# the design; two independent NUMBERS was a bug.
MAX_CHANGES_PER_HOUR=3
